{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "public",
  "regions": ["sfo1"],
  "functions": {"api/room.js": {"maxDuration": 10}},
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/index.wasm", "headers": [{ "key": "Content-Type", "value": "application/wasm" }] },
    { "source": "/index.pck", "headers": [{ "key": "Content-Type", "value": "application/octet-stream" }] }
  ]
}
